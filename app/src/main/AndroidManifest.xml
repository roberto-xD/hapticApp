<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Esta app solo EMITE anuncios BLE. No escanea ni se conecta a nada, asi que
      no necesita BLUETOOTH_SCAN, BLUETOOTH_CONNECT ni permisos de ubicacion.
      BLUETOOTH_ADVERTISE no se considera "derivable a ubicacion", por eso no
      arrastra ACCESS_FINE_LOCATION como si lo hace el escaneo.
    -->

    <!-- Android 11 y anteriores -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Modo reactivo: solo se pide cuando el usuario activa el microfono -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      El servicio en primer plano no graba: existe para que el sistema no
      silencie el microfono al minimizar la app. El permiso generico lo pide
      Android 9+; el de tipo microfono, Android 14+. Declarar los dos sin
      acotar version es inocuo en las anteriores.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".HapticControlApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HapticControl"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HapticControl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.audio.MicForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
